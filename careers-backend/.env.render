# ═══════════════════════════════════════════════════════════════
# RENDER ENVIRONMENT FILE — Upload this in Render Dashboard
# Go to: Service → Environment → "Add from .env" → paste this file
# Then fill in the actual values for each variable
# ═══════════════════════════════════════════════════════════════

# App
APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Security
SECRET_KEY=<generate-a-random-32-char-string>
INTERNAL_API_KEY=<generate-a-random-32-char-string>

# CORS — your production frontend URL
ALLOWED_ORIGINS=https://www.pebelai.com

# ═══════════════════════════════════════════════════════════════
# DATABASE — Supabase Connection Pooler
# Get from: Supabase Dashboard → Connect → Transaction Pooler tab
# Format: postgresql://postgres.[PROJECT_ID]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres
# Example: postgresql://postgres.hbtoxufjvldkywlmorun:yourpassword@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=<your-supabase-pooler-url-with-password>

# Supabase
SUPABASE_URL=https://hbtoxufjvldkywlmorun.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# AI APIs
GROQ_API_KEY=<your-groq-api-key>
GEMINI_API_KEY=<your-gemini-api-key>

# Google OAuth (for Gmail integration)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=https://www.pebelai.com/api/careers/gmail/callback
