# NextAuth (required)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
NEXTAUTH_URL=https://www.pebelai.com

# Google OAuth (required for sign-in)
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js frontend, for Vercel.
NEXT_PUBLIC_APP_URL=https://www.pebelai.com
CAREERS_API_URL=https://pebelai-careers-api.onrender.com
CAREERS_INTERNAL_API_KEY=replace-with-the-same-secret-as-backend

# FastAPI careers backend, for Render/Railway.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
FRONTEND_APP_URL=https://www.pebelai.com
CAREERS_INTERNAL_API_KEY=replace-with-the-same-secret-as-frontend
UPLOAD_DIR=/app/storage/resumes

# SMTP-first outreach sending.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM_EMAIL=sender@example.com

# Optional: enables AI-generated copy instead of the local fallback draft.
OPENAI_API_KEY=
